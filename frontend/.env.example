# Relative base URL so API calls are same-origin with the SPA (the Vite dev
# server proxies /api -> the backend). This is required for the HttpOnly auth
# cookies to flow. In production, serve the SPA and API under the same origin
# (or a reverse proxy) and keep this relative.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Car Wash Admin

# Google Maps JS API key (Maps + Places) for the Mobile-channel address picker.
# Leave blank to fall back to manual address entry (no map / autocomplete).
#
# SECURITY: this key ships to the browser (unavoidable for the Maps JS SDK), so it
# is NOT a secret - but it MUST be locked down in the Google Cloud console to stop
# abuse of your billing:
#   1. Application restriction: HTTP referrers -> allow only your admin host(s),
#      e.g. https://admin.yourdomain.com/*  (and http://localhost:5173/* for dev).
#   2. API restriction: enable ONLY "Maps JavaScript API" + "Places API".
#   3. Set a billing budget + quota alerts.
# Use a SEPARATE, restricted key per environment; never reuse the server-side
# GOOGLE_*_API_KEY values here.
VITE_GOOGLE_MAPS_API_KEY=

# Where the customer website is served. Used by the "Preview website" button on
# the Website dashboard when Organization Info -> Website is empty. Prefer
# setting it on the organization: that is read at runtime and can differ per
# deployment, whereas this is baked in at build time.
# VITE_CUSTOMER_SITE_URL=http://localhost:4321
