---
import { fromAstro } from '../i18n/index.js';
/**
 * Club and venue discovery.
 *
 * Reads the live club list from Operations (only active clubs are published),
 * so a venue opened in the admin appears here without a deployment and a closed
 * one disappears. Each card deep-links into the booking wizard with that club
 * already chosen.
 */
const { clubs = [] } = Astro.props;
const { t } = fromAstro(Astro);

/** Initials for the card mark, so a club with no logo still has an identity. */
function initials(name) {
  return (name || '')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0].toUpperCase())
    .join('') || 'CB';
}

/**
 * What a club offers, in the words the operator used.
 *
 * Capped at four so a large venue does not turn its card into a list; the count
 * keeps the remainder honest rather than hiding it.
 */
function clubTags(club) {
  // Facility NAMES: the units the operator created and named. A card chip is
  // now a string they typed, so there is never a question of where it came
  // from. Types and categories stay in the payload for search and filtering,
  // but they are not what a venue is introduced by.
  const named = club.facilities || [];
  const all = named.length ? named : (club.facility_types || club.sports || []);
  return { shown: all.slice(0, 4), extra: Math.max(0, all.length - 4) };
}
---
<div class="clubs">
  {clubs.map((club) => (
    <article class="club">
      <div class="club__top">
        <span class="club__mark" aria-hidden="true">{initials(club.name)}</span>
        <div>
          <h3 class="club__name">{club.name}</h3>
          <p class="club__where">
            {[club.city, club.address].filter(Boolean).join(' - ') || t('home.locationOnRequest')}
          </p>
        </div>
      </div>

      {clubTags(club).shown.length > 0 && (
        <div class="club__tags">
          {clubTags(club).shown.map((sport) => (
            <span class="club__tag">{sport.name}</span>
          ))}
          {clubTags(club).extra > 0 && (
            <span class="club__tag club__tag--more">+{clubTags(club).extra}</span>
          )}
        </div>
      )}

      <div class="club__foot">
        {club.phone
          ? <a class="muted" href={`tel:${club.phone}`}>{club.phone}</a>
          : <span class="muted">{t('home.bookOnline')}</span>}
        <a class="club__link" href={`/book?club=${club.id}&step=1`}>
          {t('home.checkAvailability')} &rsaquo;
        </a>
      </div>
    </article>
  ))}
</div>
