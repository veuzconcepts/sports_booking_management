---
import { getBranding } from '../lib/api.js';
import { LOCALES, fromAstro, localeHref } from '../i18n/index.js';

const { hideCta = false } = Astro.props;
const branding = await getBranding();
const name = branding?.name || 'Club Booking';
// Per-theme logos with the static file as a graceful fallback.
const logoDark = branding?.logo_dark || '/logo.svg';   // for dark backgrounds (default)
const logoLight = branding?.logo_light || '/logo.svg'; // for light backgrounds
// Anchors match the sections the homepage renders. Kept in code rather than
// the CMS because there is no menu content type: inventing one here would add a
// second place navigation is decided.
const { locale, t } = fromAstro(Astro);
const links = [
  { label: t('nav.sports'), href: '/#sports' },
  { label: t('nav.availability'), href: '/#availability' },
  { label: t('nav.clubs'), href: '/#clubs' },
  { label: t('nav.forClubs'), href: '/#owners' },
  { label: t('nav.faqs'), href: '/#faq' },
];
// Plain links, not a script: the language has to survive with JavaScript off,
// and a server round trip is what lets the whole page come back translated.
const languages = LOCALES.map((entry) => ({
  ...entry,
  href: localeHref(Astro.url, entry.code),
  current: entry.code === locale,
}));
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${name} ${t('nav.home')}`}>
      <img class="brand__logo brand__logo--dark" src={logoDark} alt={name} height="88" />
      <img class="brand__logo brand__logo--light" src={logoLight} alt={name} height="88" />
    </a>
    <nav class="nav" aria-label={t('nav.home')}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <nav class="langs" aria-label={t('common.chooseLanguage')}>
      {languages.map((entry) => (
        <a
          class:list={['langs__opt', { 'is-on': entry.current }]}
          href={entry.href}
          hreflang={entry.code}
          lang={entry.code}
          aria-current={entry.current ? 'true' : undefined}
        >{entry.native}</a>
      ))}
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label={t('nav.toggleTheme')} title={t('nav.toggleTheme')}>
      <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
      </svg>
      <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
      </svg>
    </button>
    {!hideCta && <a href="/book" class="btn btn-amber site-header__cta">{t('nav.bookNow')}</a>}
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector('[data-theme-toggle]');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var cur = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      var next = cur === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      document.documentElement.style.colorScheme = next;
      // 'cb-theme' is the key BaseLayout reads before paint. This wrote
      // 'dc-theme', so the choice was forgotten on every reload.
      try { localStorage.setItem('cb-theme', next); } catch (e) {}
      btn.setAttribute('aria-pressed', String(next === 'light'));
    });
  })();

  // Keep the language links pointing at the page as it is NOW.
  //
  // The hrefs above are built on the server from the URL the server saw. The
  // booking wizard then rewrites the URL as the customer moves through it,
  // using history.replaceState, which those server-rendered links know nothing
  // about. Switching language therefore threw away the club, the activity, the
  // add-ons and the chosen time, and dropped the customer back at the start of
  // the wizard.
  //
  // Recomputed on click rather than on load, because replaceState fires no
  // event and the URL keeps changing underneath us. The href stays as it was
  // so the link still works with JavaScript off, which is the whole reason
  // these are plain links and not a script.
  (function () {
    var opts = document.querySelectorAll('.langs__opt');
    if (!opts.length) return;
    Array.prototype.forEach.call(opts, function (link) {
      link.addEventListener('click', function (event) {
        var code = link.getAttribute('hreflang');
        if (!code || event.defaultPrevented || event.metaKey || event.ctrlKey
            || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        var here = new URL(window.location.href);
        here.searchParams.set('lang', code);
        window.location.assign(here.pathname + here.search + here.hash);
      });
    });
  })();
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex; align-items: center; gap: 24px; height: 76px;
  }
  .brand {
    display: inline-flex; align-items: center;
    transition: transform .2s ease, filter .2s ease;
  }
  .brand img {
    /* Tall so the mark reads large - uploaded logos sit inside a padded (contain)
       frame, so a bigger box is needed to match the old static logo's presence. */
    height: 52px; width: auto; max-width: 260px; object-fit: contain; display: block;
    filter: drop-shadow(0 2px 6px rgba(11, 31, 23, 0.10));
  }
  .brand:hover { transform: translateY(-1px); }
  .brand:hover img { filter: drop-shadow(0 4px 12px rgba(21, 64, 44, 0.24)); }
  @media (max-width: 600px) { .brand img { height: 40px; } .site-header__inner { height: 64px; } }
  /* Show ONLY the logo that matches the active theme (dark is the default).
     Scoped with `.brand` so these beat the `.brand img` rule on specificity. */
  .brand .brand__logo--dark { display: block; }
  .brand .brand__logo--light { display: none; }
  :global([data-theme="light"]) .brand .brand__logo--dark { display: none; }
  :global([data-theme="light"]) .brand .brand__logo--light { display: block; }
  .nav {
    display: flex; gap: 26px; margin-left: auto;
    font-weight: 500; font-size: 0.95rem;
  }
  .nav a { color: var(--text); transition: color .15s ease; }
  .nav a:hover { color: var(--ink); }
  .site-header__cta { padding: 10px 22px; }

  /* Theme switcher */
  .theme-toggle {
    width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0;
    display: grid; place-items: center; cursor: pointer;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink);
    transition: color .2s ease, border-color .2s ease, transform .2s ease, background .2s ease;
  }
  .theme-toggle:hover { color: var(--brand-soft); border-color: var(--brand-soft); transform: translateY(-1px); }
  .theme-toggle svg { display: block; }
  /* Dark (default) shows the sun (click → light); light shows the moon. */
  .theme-toggle__moon { display: none; }
  :global([data-theme="light"]) .theme-toggle__sun { display: none; }
  :global([data-theme="light"]) .theme-toggle__moon { display: block; }

  @media (max-width: 900px) {
    .nav { display: none; }
    .theme-toggle { margin-left: auto; }
  }
</style>
