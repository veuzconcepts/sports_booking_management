---
import { getBranding } from '../lib/api.js';

const { hideCta = false } = Astro.props;
const branding = await getBranding();
const name = branding?.name || 'Club Booking';
// Per-theme logos with the static file as a graceful fallback.
const logoDark = branding?.logo_dark || '/logo.svg';   // for dark backgrounds (default)
const logoLight = branding?.logo_light || '/logo.svg'; // for light backgrounds
const links = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '#services' },
  { label: 'About Us', href: '#why' },
  { label: 'FAQs', href: '#faq' },
  { label: 'Contact', href: '#footer' },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${name} home`}>
      <img class="brand__logo brand__logo--dark" src={logoDark} alt={name} height="88" />
      <img class="brand__logo brand__logo--light" src={logoLight} alt={name} height="88" />
    </a>
    <nav class="nav" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch between dark and light theme" title="Switch theme">
      <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
      </svg>
      <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
      </svg>
    </button>
    {!hideCta && <a href="/book" class="btn btn-amber site-header__cta">Book Now</a>}
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector('[data-theme-toggle]');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var cur = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      var next = cur === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      document.documentElement.style.colorScheme = next;
      try { localStorage.setItem('dc-theme', next); } catch (e) {}
      btn.setAttribute('aria-pressed', String(next === 'light'));
    });
  })();
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex; align-items: center; gap: 24px; height: 100px;
  }
  .brand {
    display: inline-flex; align-items: center;
    transition: transform .2s ease, filter .2s ease;
  }
  .brand img {
    /* Tall so the mark reads large - uploaded logos sit inside a padded (contain)
       frame, so a bigger box is needed to match the old static logo's presence. */
    height: 88px; width: auto; max-width: 340px; object-fit: contain; display: block;
    /* a touch of depth so the wordmark stands out crisply on white */
    filter: drop-shadow(0 2px 6px rgba(33, 27, 78, 0.12));
  }
  .brand:hover { transform: translateY(-1px); }
  .brand:hover img { filter: drop-shadow(0 4px 12px rgba(111, 74, 158, 0.28)); }
  @media (max-width: 600px) { .brand img { height: 60px; } .site-header__inner { height: 76px; } }
  /* Show ONLY the logo that matches the active theme (dark is the default).
     Scoped with `.brand` so these beat the `.brand img` rule on specificity. */
  .brand .brand__logo--dark { display: block; }
  .brand .brand__logo--light { display: none; }
  :global([data-theme="light"]) .brand .brand__logo--dark { display: none; }
  :global([data-theme="light"]) .brand .brand__logo--light { display: block; }
  .nav {
    display: flex; gap: 26px; margin-left: auto;
    font-weight: 500; font-size: 0.95rem;
  }
  .nav a:hover { color: var(--indigo-600); }
  .site-header__cta { padding: 10px 22px; }

  /* Theme switcher */
  .theme-toggle {
    width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0;
    display: grid; place-items: center; cursor: pointer;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink);
    transition: color .2s ease, border-color .2s ease, transform .2s ease, background .2s ease;
  }
  .theme-toggle:hover { color: var(--amber-600); border-color: var(--amber-600); transform: translateY(-1px); }
  .theme-toggle svg { display: block; }
  /* Dark (default) shows the sun (click → light); light shows the moon. */
  .theme-toggle__moon { display: none; }
  :global([data-theme="light"]) .theme-toggle__sun { display: none; }
  :global([data-theme="light"]) .theme-toggle__moon { display: block; }

  @media (max-width: 900px) {
    .nav { display: none; }
    .theme-toggle { margin-left: auto; }
  }
</style>
