---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HomeHero from '../components/HomeHero.astro';
import ClubGrid from '../components/ClubGrid.astro';
import OwnerCta from '../components/OwnerCta.astro';
import AvailabilityPreview from '../components/AvailabilityPreview.jsx';
import Footer from '../components/Footer.astro';
import CampaignPopup from '../components/CampaignPopup.jsx';
import { getHome, getCatalogue, getClubs, getCampaigns } from '../lib/api.js';
import '../styles/home.css';
import '../styles/campaign.css';

/**
 * The homepage.
 *
 * Two sources, no third: the CMS supplies presentation (headings, banners,
 * steps, testimonials, FAQ, footer) and Operations supplies the live business
 * data (clubs, categories, bookable facility types, availability). Nothing on
 * this page re-authors either, so what an operator changes in the admin is what
 * a customer sees.
 *
 * Every section renders only when it has content, which means an organization
 * that has not written a section simply does not get an empty one.
 */
const [home, catalogue, clubList, campaignList] = await Promise.all([
  getHome(), getCatalogue(), getClubs(), getCampaigns({ placement: 'home' }),
]);

const sections = home?.sections || {};
const sec = (key) => sections[key] || {};
const site = home?.organization || {};

const banners = home?.banners || [];
const steps = home?.process_steps || [];
const categories = catalogue?.categories || [];
const facilityTypes = catalogue?.facility_types || [];
const clubs = clubList?.clubs || [];
// Eligibility was settled server-side; the island only decides how often.
const campaigns = campaignList?.campaigns || [];
const why = home?.why_choose_us || [];
const stats = home?.stats || [];
const testimonials = home?.testimonials || [];
const brands = home?.brands || [];
const faqs = home?.faqs || [];
const cta = sec('cta_band');

// Sports a customer can actually book: a category with no bookable facility
// type behind it would lead to a dead end.
const bookableCategoryIds = new Set(facilityTypes.flatMap((t) => t.category_ids || []));
const sports = categories.filter((c) => bookableCategoryIds.has(c.id));

/** How many bookable facility types sit under a sport, for the card subtitle. */
const typeCount = (categoryId) =>
  facilityTypes.filter((t) => (t.category_ids || []).includes(categoryId)).length;
---
<BaseLayout seo={home?.seo} site={site}>
  <Header />

  <HomeHero
    section={sec('hero')}
    banners={banners}
    categories={categories}
    facilityTypes={facilityTypes}
    clubs={clubs}
    stats={stats}
  />

  <!-- Sports: the live facility catalogue, not a hand-written list -->
  {sports.length > 0 && (
    <section class="section" id="sports">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">{sec('services').eyebrow || 'Choose your sport'}</span>
          <h2>{sec('services').title || 'What would you like to play?'}</h2>
          {sec('services').description && <p class="muted">{sec('services').description}</p>}
        </div>
        <div class="sports">
          {sports.map((sport) => (
            <a class={`sport${sport.banner || sport.icon ? ' has-img' : ''}`}
              href={`/book?category=${sport.id}`} aria-label={sport.name}>
              {(sport.banner || sport.icon) && (
                <>
                  <img class="sport__img" src={sport.banner || sport.icon} alt="" loading="lazy" />
                  <span class="sport__veil" aria-hidden="true"></span>
                </>
              )}
              <span class="sport__name">{sport.name}</span>
              <span class="sport__meta">
                {typeCount(sport.id) === 1 ? '1 facility' : `${typeCount(sport.id)} facilities`}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Live availability: the same engine the booking flow uses -->
  {clubs.length > 0 && (
    <section class="section section--soft" id="availability">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">{sec('availability').eyebrow || 'Live availability'}</span>
          <h2>{sec('availability').title || 'See what is free right now'}</h2>
          {sec('availability').description && (
            <p class="muted">{sec('availability').description}</p>
          )}
        </div>
        <AvailabilityPreview client:visible clubs={clubs} facilityTypes={facilityTypes} />
      </div>
    </section>
  )}

  <!-- Clubs and venues -->
  {clubs.length > 0 && (
    <section class="section" id="clubs">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">{sec('clubs').eyebrow || 'Our venues'}</span>
          <h2>{sec('clubs').title || 'Find a club near you'}</h2>
          {sec('clubs').description && <p class="muted">{sec('clubs').description}</p>}
        </div>
        <ClubGrid clubs={clubs} sports={sports} />
      </div>
    </section>
  )}

  <!-- How it works -->
  {steps.length > 0 && (
    <section class="section section--soft" id="how">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">{sec('how_it_works').eyebrow || 'How it works'}</span>
          <h2>{sec('how_it_works').title || 'Booked in four steps'}</h2>
        </div>
        <div class="steps2">
          {steps.map((step, i) => (
            <div class="step2">
              <span class="step2__no">{step.step_no || String(i + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Why choose us -->
  {why.length > 0 && (
    <section class="section" id="why">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">{sec('why_choose_us').eyebrow || 'Why us'}</span>
          <h2>{sec('why_choose_us').title || 'Your club, always within reach'}</h2>
          {sec('why_choose_us').description && (
            <p class="muted">{sec('why_choose_us').description}</p>
          )}
        </div>
        <div class="steps2">
          {why.map((point) => (
            <div class="step2">
              <h3>{point.title}</h3>
              <p>{point.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- For club owners -->
  <section class="section" id="owners">
    <div class="container">
      <OwnerCta section={sec('owner_cta')} site={site} />
    </div>
  </section>

  <!-- Testimonials -->
  {testimonials.length > 0 && (
    <section class="section section--soft" id="reviews">
      <div class="container">
        <div class="section-head section-head--center">
          <span class="eyebrow">{sec('testimonials').eyebrow || 'Our customers say'}</span>
          <h2>{sec('testimonials').title || 'Trusted reviews'}</h2>
        </div>
        <div class="grid cols-3">
          {testimonials.map((review) => (
            <blockquote class="card review">
              <p>“{review.quote}”</p>
              <footer>
                <strong>{review.author_name}</strong>
                {review.author_role && <span class="muted"> · {review.author_role}</span>}
                <div class="review__stars" aria-label={`${review.rating} out of 5`}>
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.rating ? 'on' : ''}>★</span>
                  ))}
                </div>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Trusted brands: CMS-authored, so it stays even though the reference
       layout does not show one. Dropping it would delete an operator's work. -->
  {brands.length > 0 && (
    <section class="section" id="brands">
      <div class="container">
        <div class="section-head section-head--center">
          <span class="eyebrow">{sec('brands').eyebrow || 'Trusted by'}</span>
          <h2>{sec('brands').title || 'Trusted brands'}</h2>
        </div>
        <div class="brands">
          {brands.map((b) => (
            <div class={`brand-logo${b.logo_detail?.url ? '' : ' brand-logo--text'}`}>
              {b.logo_detail?.url
                ? <img src={b.logo_detail.url} alt={b.name} loading="lazy" />
                : <span>{b.name}</span>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ (native, no-JS accordion) -->
  {faqs.length > 0 && (
    <section class="section" id="faq">
      <div class="container faq">
        <div class="faq__head">
          <span class="eyebrow">{sec('faq').eyebrow || 'FAQ'}</span>
          <h2>{sec('faq').title || 'Frequently asked questions'}</h2>
        </div>
        <div class="faq__panel">
          {faqs.map((faq, i) => (
            <details class="faq__item" open={i === 0}>
              <summary>
                <span class="faq__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="faq__q">{faq.question}</span>
                <span class="faq__icon" aria-hidden="true"></span>
              </summary>
              <div class="faq__a"><p>{faq.answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Closing call to action -->
  <section class="cta" id="book">
    <div class="container cta__inner">
      <div>
        <h2>{cta.title || "Ready to play? Let's get you booked."}</h2>
        {cta.subtitle && <p>{cta.subtitle}</p>}
      </div>
      <a href={cta.primary_button_url || '/book'} class="btn btn-amber">
        {cta.primary_button_label || 'Book now'}
      </a>
    </div>
  </section>

  {campaigns.length > 0 && <CampaignPopup client:idle campaigns={campaigns} />}

  <Footer footer={home?.footer} site={site} />
</BaseLayout>

<style>
  /* Review cards keep their existing treatment; only the palette moved. */
  .review p { font-size: 1.02rem; color: var(--ink); }
  .review footer { margin-top: 14px; font-size: 0.92rem; }
  .review__stars { margin-top: 6px; color: var(--disabled); letter-spacing: 2px; }
  .review__stars .on { color: var(--accent-strong); }
</style>
