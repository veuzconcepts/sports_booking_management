---
import { fromAstro } from '../i18n/index.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import BookingWizard from '../components/BookingWizard.jsx';
import CampaignPopup from '../components/CampaignPopup.jsx';
import { getHome, getCatalogue, getClubs, getCampaigns } from '../lib/api.js';
import '../styles/booking.css';
import '../styles/campaign.css';
import '../styles/payment.css';

const { locale } = fromAstro(Astro);

const [home, catalogue, clubData, campaignList] = await Promise.all([
  getHome(), getCatalogue(), getClubs(), getCampaigns({ placement: 'booking' }),
]);
const campaigns = campaignList?.campaigns || [];
const categories = catalogue?.categories || [];
const facilityTypes = catalogue?.facility_types || [];
const clubs = clubData?.clubs || [];
const currency = catalogue?.currency || '';
const city = home?.organization?.city || '';
const country = home?.organization?.country || '';
// Logo used as the placeholder when a facility type / category has no image.
const placeholderLogo = home?.branding?.logo_dark || home?.branding?.logo_light || '';
---
<BaseLayout seo={{ meta_title: 'Book a facility', robots: 'noindex, follow' }} site={home?.organization || {}}>
  <Header hideCta />
  <section class="section section--flush-top">
    <div class="container">
      <BookingWizard
        client:load
        locale={locale}
        categories={categories}
        facilityTypes={facilityTypes}
        clubs={clubs}
        currency={currency}
        city={city}
        country={country}
        placeholderLogo={placeholderLogo}
      />
    </div>
  </section>
  {campaigns.length > 0 && <CampaignPopup client:idle campaigns={campaigns} locale={locale} />}
</BaseLayout>
