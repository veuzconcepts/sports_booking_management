# Base URL of the Django API (server-side fetches from the SSR runtime).
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Public site URL (used for canonical / Open Graph tags and the sitemap).
SITE_URL=http://localhost:4321

# Optional: Google Maps JS key for the booking location step (club map pins).
# Without it, the location step still works as a searchable club list.
PUBLIC_GOOGLE_MAPS_API_KEY=
