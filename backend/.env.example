# --- Django ---
# Generate strong unique values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-in-production-please
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings

# --- JWT signing key (separate from SECRET_KEY; rotate independently) ---
JWT_SIGNING_KEY=change-me-jwt-signing-key

# --- Database (PostgreSQL) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=booking_management
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# --- JWT ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# Opaque server-side sessions (browser cookie path): when True the auth cookies
# carry a random handle and the JWT is held server-side, so no JWT ever reaches
# the browser. The Authorization: Bearer path (API clients) is unaffected. REQUIRES a
# shared, persistent, non-evicting cache in production (set USE_REDIS_CACHE=True
# with Redis maxmemory-policy noeviction). Default off - opt in when ready.
USE_OPAQUE_SESSIONS=False

# --- Auth security ---
# Password policy
PASSWORD_MIN_LENGTH=12
# Brute-force throttling (DRF scoped rates) and per-account lockout
THROTTLE_LOGIN=10/min
THROTTLE_MFA=10/min
THROTTLE_REGISTER=5/min
THROTTLE_PASSWORD=5/min
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
# Use a shared Redis cache for throttle/lockout in production (multi-process)
USE_REDIS_CACHE=False
# CACHE_REDIS_URL=redis://127.0.0.1:6379/2
# Set True when running behind a TLS-terminating proxy/load balancer (prod)
BEHIND_TLS_PROXY=False
# Number of trusted proxies in front of the app (0 = keyed on REMOTE_ADDR). Behind
# the single-origin reverse proxy (deploy/nginx.conf) set this to 1 so the login /
# throttle keys on the genuine client IP from X-Forwarded-For.
NUM_PROXIES=0

# --- CORS / CSRF ---
# Behind the single-origin reverse proxy the SPA is same-origin with the API, so
# CORS is not needed for it. CORS only matters for cross-origin clients (the Astro
# website calling a differently-hosted API).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Origins trusted for cookie-authenticated writes (admin dashboard). In production
# set this to your real dashboard URL(s), e.g. https://admin.yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Security response headers (config.security_headers) ---
# Strict CSP applied to NON-HTML (API/JSON) responses; a JSON reply is never an
# executable document. The admin SPA's own CSP lives in deploy/nginx.conf.
API_CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
# Roll CSP out in monitor mode first (emits Content-Security-Policy-Report-Only),
# then set back to False to enforce.
CSP_REPORT_ONLY=False
# Permissions-Policy sent on every response (disables unused browser features).
PERMISSIONS_POLICY=accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()

# --- Redis / Celery ---
# USE_CELERY=False (default) runs tasks inline (no broker/worker needed). In
# production set USE_CELERY=True and run all three Procfile processes: web,
# worker, and beat (the periodic scheduler — membership expiry, due transfers).
USE_CELERY=False
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# --- Email (dev: console backend) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Business defaults ---
DEFAULT_CURRENCY=USD
DEFAULT_TAX_RATE=0.05

# --- Google Maps / Places / Geocoding (optional; club location picker) ---
# No hardcoded keys. The frontend reads VITE_GOOGLE_MAPS_API_KEY (see
# frontend/.env.example). These server-side placeholders are for any future
# server-side geocoding/validation.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_PLACES_API_KEY=your-google-maps-api-key
GOOGLE_GEOCODING_API_KEY=your-google-maps-api-key
